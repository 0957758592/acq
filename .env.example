# @acq — environment (12-factor, REQUIREM §11). Copy to .env and fill what you need.
# Empty = the feature stays an honest coded seam until you provide the value.

# ── Infrastructure ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/acq
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://127.0.0.1:5672
LOG_LEVEL=info

# ── Control plane (facade over REST·MCP·gRPC·WS·GraphQL·A2A·CLI·SSE·webhooks) ──
CONTROL_PORT=7500
GRPC_PORT=7550
CONTROL_ADMIN_TOKEN=admin-dev-token       # bearer -> role: admin
CONTROL_READONLY_TOKEN=                    # bearer -> role: readonly
CONTROL_ORIGIN=self                        # dashboard CSP api origin
WEBHOOK_SECRET=                            # HMAC for inbound /webhooks/inbound

# ── Engine (reconciler loop / pool / autobuy) ─────────────────────────────────
ENGINE_HEALTH_PORT=7401
ENGINE_RECONCILE_CRON=*/5 * * * *
ENGINE_POOL_THRESHOLD=10                   # refill when a platform pool drops below this
ENGINE_BUY_BATCH_SIZE=5
ENGINE_AUTOBUY_ENABLED=false               # true => reconciler auto-buys to refill the pool
PLATFORMS=                                 # comma list; empty = all registered platforms

# ── Dashboard / scrape worker ─────────────────────────────────────────────────
DASHBOARD_PORT=7600
SCRAPE_HEALTH_PORT=7700

# ── AI / LLM backends (pluggable; llm.providers / llm.complete / shop.scan) ────
# Set any one (or more). LLM_PROVIDER picks the default; any call may override.
OPENAI_API_KEY=                            # default vendor (gpt-5-codex)
ANTHROPIC_API_KEY=                         # claude-opus-5 / fable-5
GOOGLE_API_KEY=                            # gemini-2.5-pro
OPENROUTER_API_KEY=
LLM_API_KEY=                               # custom OpenAI-compatible endpoint
LLM_PROVIDER=                              # openai|anthropic|google|openrouter|custom
LLM_MODEL=
LLM_BASE_URL=                             # for provider=custom

# ── Browser backends (browser.providers / browser.session.* / browser.act) ────
BROWSER_PROVIDER=own                       # own (self-hosted pool) | browserbase (cloud)
BROWSERBASE_API_KEY=                       # enables the Browserbase cloud backend
BROWSERBASE_PROJECT_ID=
BROWSER_CONCURRENCY=4
BROWSER_DEBUG_PORT=0                        # >0 exposes the live-view devtools URL

# ── Cloud-phone devices (DuoPlus) ─────────────────────────────────────────────
DUOPLUS_API_KEY=
DUOPLUS_API_BASE_URL=https://openapi.duoplus.net
DUOPLUS_TEST_DEVICE_ID=                     # a RUNNING device id for the live device harnesses

# ── Shops (procurement) — api-key (bearer) or a session cookie (cookie-session)─
DARKSHOP_API_KEY=
DARKSHOP_BASE_URL=
DJEKXA_API_KEY=
DJEKXA_BASE_URL=

# ── Email verification (mail × shops harness; use a Gmail APP PASSWORD) ────────
TEST_MAIL_ADDRESS=
TEST_MAIL_PASSWORD=                         # app-password, NOT the web password
TEST_MAIL_IMAP_HOST=                        # only for proton (bridge) / firstmail (per-batch)
TEST_MAIL_IMAP_PORT=

# ── Secrets / sessions ────────────────────────────────────────────────────────
COOKIE_SESSION_KEY=                         # enables the encrypted shop cookie-session store

# ── Telegram scrape (bot-api tier) ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── CLI (`acq <op> key=value` against a deployed server) ──────────────────────
ACQ_BASE_URL=http://localhost:7500
ACQ_TOKEN=                                  # falls back to CONTROL_ADMIN_TOKEN
