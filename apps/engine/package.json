{
  "name": "@acq/engine-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/engine.js",
  "scripts": {
    "start": "node ./src/engine.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.js --passWithNoTests",
    "test:live": "cross-env ACQ_LIVE=1 NODE_OPTIONS=--experimental-vm-modules jest -c jest.live.config.js --runInBand",
