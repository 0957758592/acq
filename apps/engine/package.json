    "@acq/proxy": "*",
    "@acq/device-control": "*",
    "@acq/config": "*",
    "@acq/logger": "0.1.0",
    "node-cron": "^3.0.3",
    "@acq/browser": "*",
    "@acq/integrations": "*",
    "@acq/account-gen": "*"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "jest": "^29.7.0"
  }
}
