{
  "name": "@acq/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./db/*": "./src/db/*.js",
    "./queue/*": "./src/queue/*.js",
    "./models/*": "./src/models/*.model.js",
    "./services/*": "./src/services/*.service.js",
    "./utils/*": "./src/utils/*.js",
    "./observability/*": "./src/observability/*.js",
    "./reliability/*": "./src/reliability/*.js",
    "./auth/*": "./src/auth/*.js",
    "./config/*": "./src/config/*.js"
  },
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.js --passWithNoTests",
    "lint": "eslint .",
    "build": "node -e \"console.log('core: no build step')\""
  },
  "dependencies": {
    "@acq/config": "*",
    "@acq/shared": "*",
    "mongoose": "^8.7.0",
    "ioredis": "^5.4.1",
    "amqplib": "^0.10.4",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "jest": "^29.7.0"
  }
}
